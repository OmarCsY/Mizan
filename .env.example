# Copy to .env and fill in. Never commit .env. Values here stay empty.

# Supabase Postgres: session pooler (port 5432) or direct URL, NOT the transaction pooler (DECISIONS D-7)
DATABASE_URL=

LLM_PROVIDER=            # anthropic | openai_compatible
LLM_API_KEY=
LLM_BASE_URL=            # only for openai_compatible
LLM_MODEL_EXTRACT=
LLM_MODEL_VERIFY=
LLM_MODEL_REPLY=
LLM_TIMEOUT_S=8

EMBEDDING_PROVIDER=      # openai_compatible | cohere | voyage
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# Pinned approved QuranEnc translation keys (SPEC §4.2, chosen in B02 from the live list)
QURANENC_KEY_EN=
QURANENC_KEY_UR=
DORAR_BASE_URL=https://dorar.net

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

PUBLIC_WEB_URL=          # frontend base URL, for bot "details" links
ALLOWED_ORIGINS=         # comma-separated, e.g. https://<pages-domain>,http://localhost:5173
MAX_INPUT_CHARS=4000
RESULT_TTL_HOURS=24
