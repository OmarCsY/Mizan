# Copy to .env and fill in. Never commit .env. Values here stay empty.

# Supabase Postgres: session pooler (port 5432) or direct URL, NOT the transaction pooler (DECISIONS D-7)
DATABASE_URL=

# Free tiers only (DECISIONS D-15): Gemini via its OpenAI-compatible endpoint, Groq as quota fallback.
LLM_PROVIDER=            # openai_compatible (Gemini) | anthropic
LLM_API_KEY=
LLM_BASE_URL=            # https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL_EXTRACT=       # set by: python scripts/pick_llm_model.py --write
LLM_MODEL_VERIFY=
LLM_MODEL_REPLY=
LLM_TIMEOUT_S=8
LLM_EFFORT=low           # anthropic only; leave empty for models without effort (e.g. Haiku 4.5)
LLM_REASONING_EFFORT=    # openai_compatible reasoning_effort, optional
GROQ_API_KEY=            # optional: quota fallback (openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

EMBEDDING_PROVIDER=      # gemini | openai_compatible | cohere | voyage
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=         # gemini-embedding-001
EMBEDDING_DIM=1024
EMBEDDING_RPM=100        # client-side limit, texts per minute (check AI Studio > Rate limits); 0 = off
EMBEDDING_TPM=30000      # client-side limit, estimated tokens per minute; 0 = off

# Pinned approved QuranEnc translation keys (SPEC §4.2, chosen in B02 from the live list, see docs/SOURCES.md)
QURANENC_KEY_EN=         # english_rwwad
QURANENC_KEY_UR=         # urdu_junagarhi
DORAR_BASE_URL=https://dorar.net

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

PUBLIC_WEB_URL=          # frontend base URL, for bot "details" links
ALLOWED_ORIGINS=         # comma-separated, e.g. https://<pages-domain>,http://localhost:5173
MAX_INPUT_CHARS=4000
RESULT_TTL_HOURS=24
